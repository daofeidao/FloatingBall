# Auto detect text files and perform LF normalization
* text=auto

# 这些文件必须是 LF —— CRLF 会让 shell 脚本在 CI 上报 invalid option name
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.mm text eol=lf
*.m text eol=lf
*.h text eol=lf
*.swift text eol=lf
*.pch text eol=lf
Makefile text eol=lf
*.plist text eol=lf
*.py text eol=lf
*.md text eol=lf

# 二进制
*.png binary
*.ipa binary
*.tipa binary
*.car binary
*.gif binary
